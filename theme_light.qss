/* =========================================================================
   SISTEMA DE DESIGN GLOBAL (LIGHT MODE) - CORRIGIDO E BLINDADO
========================================================================= */

/* 1. CONFIGURAÇÕES GLOBAIS E ESTRUTURA (Respeitando seu layout original)
------------------------------------------------------------------------- */
QWidget {
    font-family: "Segoe UI";
}

QWidget#MainWindow, QWidget#HubWindow { 
    background-color: #F1F3F4; 
}

QWidget#ScrollContent { 
    background-color: #FFFFFF; 
}

QWidget#LeftPanel {
    background-color: #FFFFFF;
    border-right: 1px solid #EBEBEB;
}

QWidget#Footer { 
    background-color: #FFFFFF; 
    border-top: 1px solid #DADCE0; 
}

QScrollArea { 
    border: none; 
    background-color: transparent; 
}

/* 2. TIPOGRAFIA ORIGINAL
------------------------------------------------------------------------- */
QLabel { font-size: 12px; color: #3C4043; }
QLabel#AppTitle { font-size: 22px; font-weight: 600; color: #1A73E8; padding: 5px 0px; }
QLabel#SectionTitle { font-size: 14px; font-weight: bold; color: #202124; margin-top: 15px; margin-bottom: 5px; }
QLabel#GridHeader { font-size: 12px; font-weight: bold; color: #5F6368; padding-bottom: 5px; }
QLabel#HeaderLabel { font-size: 18px; font-weight: bold; color: #202124; padding-bottom: 10px; }
QLabel#FooterText { font-size: 11px; color: #5F6368; font-weight: bold; }
QLabel#StatusLabel { font-size: 12px; color: #5F6368; font-style: italic; }

/* 3. GROUPBOX (O quadro encapsulado perfeito)
------------------------------------------------------------------------- */
QGroupBox { 
    background-color: #FFFFFF; 
    border: 1px solid #E1E4E8; 
    border-radius: 8px; 
    font-size: 13px; 
    font-weight: 600; 
    color: #202124; 
    margin-top: 15px; 
    padding-top: 15px; 
}
QGroupBox::title { 
    subcontrol-origin: margin; 
    subcontrol-position: top left; 
    padding: 0px 8px; 
    left: 15px; 
    background-color: #FFFFFF; /* Cobre a linha perfeitamente */
}

/* 4. INPUTS E CAMPOS DE FORMULÁRIO (Medidas originais restauradas)
------------------------------------------------------------------------- */
QLineEdit, QComboBox { 
    background-color: #F8F9FA; 
    border: 1px solid #DADCE0; 
    border-radius: 4px; 
    padding: 6px; /* Voltou para o 6px original para não estourar a grid */
    color: #202124; 
    font-weight: bold; 
}
QLineEdit:focus, QComboBox:focus, QComboBox:hover { 
    border: 1px solid #1A73E8; 
    background-color: #FFFFFF; 
}
QLineEdit[readOnly="true"] { 
    background-color: #F1F3F4; 
    color: #5F6368; 
    font-weight: normal; 
    border: 1px solid #E8EAED; 
}
QComboBox::drop-down { border: none; width: 25px; }

/* 5. LISTAS DO HUB (Isoladas para não quebrar comboboxes)
------------------------------------------------------------------------- */
QListWidget#SectorsList { 
    border: none; background-color: transparent; padding: 0px; outline: none;
}
QListWidget#SectorsList::item { 
    font-size: 14px; font-weight: 500; color: #3C4043; padding: 12px 16px; border-radius: 20px; margin-bottom: 4px; outline: none;
}
QListWidget#SectorsList::item:hover { background-color: #F1F3F4; }
QListWidget#SectorsList::item:selected { background-color: #E8F0FE; color: #1A73E8; font-weight: bold; }

QListWidget#ScriptsList { 
    background-color: #FFFFFF; border: 1px solid #DADCE0; border-radius: 8px; padding: 8px; outline: none; 
}
QListWidget#ScriptsList::item { 
    font-size: 14px; color: #202124; padding: 14px 16px; margin-bottom: 2px; border-radius: 6px; border-bottom: 1px solid #F1F3F4;
}
QListWidget#ScriptsList::item:hover { background-color: #F8F9FA; }
QListWidget#ScriptsList::item:selected { background-color: #E8F0FE; color: #1967D2; font-weight: bold; border-left: 4px solid #1A73E8; }

/* 6. BOTÕES (Isolados por ID para não destruir botões internos nativos)
------------------------------------------------------------------------- */
QPushButton#btn_processar, QPushButton#PrimaryButton, QPushButton#RunButton { 
    background-color: #1A73E8; 
    color: white; 
    font-size: 13px; 
    font-weight: 600; 
    border: none; 
    padding: 10px 20px; 
    border-radius: 6px; 
}
QPushButton#btn_processar:hover, QPushButton#PrimaryButton:hover, QPushButton#RunButton:hover { background-color: #1557B0; }
QPushButton#btn_processar:pressed, QPushButton#PrimaryButton:pressed, QPushButton#RunButton:pressed { background-color: #114B99; }
QPushButton#btn_processar:disabled, QPushButton#PrimaryButton:disabled, QPushButton#RunButton:disabled { background-color: #A0C3FF; }

QPushButton#btn_secundario, QPushButton#SecondaryButton { 
    background-color: #F8F9FA; 
    color: #3C4043; 
    font-weight: bold; 
    border: 1px solid #DADCE0; 
    padding: 7px 15px; 
    border-radius: 4px; 
}
QPushButton#btn_secundario:hover, QPushButton#SecondaryButton:hover { background-color: #E8EAED; }

QPushButton#btn_reprocessar { background-color: #34A853; color: white; font-size: 13px; font-weight: 600; border: none; padding: 10px 20px; border-radius: 6px; }
QPushButton#btn_reprocessar:hover { background-color: #2b8c44; }

QPushButton#btn_help { 
    background-color: transparent; 
    border: 2px solid #1A73E8; 
    color: #1A73E8; 
    font-size: 16px; 
    font-weight: bold; 
    border-radius: 15px; 
    min-width: 30px; 
    min-height: 30px; 
    max-width: 30px; 
    max-height: 30px;
    padding: 0px; 
}
QPushButton#btn_help:hover { background-color: #E8F0FE; }

/* 7. BARRA DE PROGRESSO E SCROLLBARS
------------------------------------------------------------------------- */
QProgressBar { 
    border: 1px solid #DADCE0; 
    border-radius: 3px; 
    background-color: #F1F3F4; 
    text-align: center; 
    color: transparent; 
    min-height: 8px;
    max-height: 8px;
}
QProgressBar::chunk { background-color: #1A73E8; border-radius: 3px; }
QProgressBar[state="success"]::chunk { background-color: #34A853; }
QProgressBar[state="error"]::chunk { background-color: #EA4335; }

QScrollBar:vertical { border: none; background: transparent; width: 8px; margin: 0px; }
QScrollBar::handle:vertical { background: #DADCE0; min-height: 20px; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background: #BDC1C6; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { border: none; background: none; }

QScrollBar:horizontal { border: none; background: transparent; height: 8px; margin: 0px; }
QScrollBar::handle:horizontal { background: #DADCE0; min-width: 20px; border-radius: 4px; }
QScrollBar::handle:horizontal:hover { background: #BDC1C6; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { border: none; background: none; }